{
  "name": "all3-indicative-offer-engine",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Indicative Offer Engine — прототип-симулятор CPQ для All3. Локальный запуск; перенос в продакшн выполняют девопсы All3.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "test:browser:desktop": "node tests/browser/run-desktop-smoke.mjs",
    "typecheck": "tsc -b --noEmit",
    "verify": "python3 -m unittest tools.test_validation_isolation && python3 tools/verify.py && python3 tools/check_indices.py && python3 tools/check_i18n_ascii.py && python3 tools/build_fixtures.py --check && python3 tools/selftest_governance.py && python3 tools/selftest_warnings.py && python3 tools/check_scenario2.py && python3 tools/check_scenario2.py --selftest",
    "gate:declare": "node tools/gate/declare-candidate.mjs",
    "vr2:gate": "node tools/vr2/check-evidence.mjs",
    "dev:main": "node tools/worktrees/dev-main.mjs",
    "git:worktrees:check": "node tools/worktrees/check.mjs",
    "release:worktree:cleanup": "node tools/worktrees/release-cleanup.mjs",
    "runtime:main": "node tools/runtime/main.mjs main",
    "runtime:candidate": "node tools/runtime/main.mjs candidate",
    "runtime:stop": "node tools/runtime/main.mjs stop",
    "runtime:status": "node tools/runtime/main.mjs status",
    "runtime:preflight": "node tools/runtime/main.mjs preflight",
    "task:base": "node tools/runtime/main.mjs task-base",
    "browser:agent:setup": "playwright-cli install --skills && playwright-cli install --skills=agents",
    "browser:agent:open": "node tools/browser-agent/open.mjs",
    "browser:agent:status": "node tools/browser-agent/status.mjs",
    "browser:agent:close": "node tools/browser-agent/close.mjs",
    "browser:agent:show": "playwright-cli show"
  },
  "dependencies": {
    "decimal.js": "^10.4.3",
    "framer-motion": "^11.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.18",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vitest": "^2.1.3"
  }
}
